  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\COM\Oil level glass.COM.csproj" />
    <ProjectReference Include="..\KompasWPF\KompasWPF.csproj" />
    <ProjectReference Include="..\Oil level glass.ViewModels\Oil level glass.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\appIcon.ico" />
    <Resource Include="Resources\Images\Glass.png" />
    <Resource Include="Resources\Images\Oil level glass.png" />
  </ItemGroup>

</Project>
