<local:EditorWindow x:Class="Oil_level_glass_UI.Windows.Editors.HousingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:user="clr-namespace:KompasWPF.UserControls;assembly=KompasWPF"
        xmlns:local="clr-namespace:Oil_level_glass_UI.Windows.Editors"
        xmlns:converter="clr-namespace:Oil_level_glass_UI.Converters"
        mc:Ignorable="d"
        Title="Размеры линзы"
        Height="600" 
        Width="550"
        ResizeMode="NoResize" 
        ShowInTaskbar="False">
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid Background="#F2F2F2">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource FormButton}">

                </Style>
                <converter:DoubleConverter x:Key="doubleConverter"></converter:DoubleConverter>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Border  Grid.Row="0" BorderBrush="Black" BorderThickness="0 0 0 2" Grid.ColumnSpan="2">
                <StackPanel>
                    <StackPanel Height="20" Background="#E4E4E4" Name="WindowHeader"></StackPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="10" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"  Name="grSizes">
                    <Grid.Resources>
                        <Style TargetType="Label">
                            <Setter Property="Padding" Value="0"></Setter>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Margin" Value="0 0 20 0"></Setter>
                            <Setter Property="Width" Value="100"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Диаметры" Margin="10" Grid.Row="0">
                        
                    </GroupBox>
                    <GroupBox Header="Высоты" Margin="10" Grid.Row="1">

                    </GroupBox>
                    <GroupBox Header="Фаска" Margin="10" Grid.Row="2">
                        <Grid Margin="5 0 5 5">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Label Content="Угол a"></Label>
                                <TextBox></TextBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0 5 0 0">
                                <Label Content="Длина l"></Label>
                                <TextBox></TextBox>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Отверстия" Margin="10" Grid.Row="3">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>

                            <user:ThreadChooser></user:ThreadChooser>
                        </Grid>
                    </GroupBox>

                    <Button 
                        Grid.Row="4"
                        Width="100" 
                        Click="BtCheck_Click"
                        Command="{Binding CheckCommand}"
                        Height="20" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Content="Проверить...">
                    </Button>
                </Grid>
            </Grid>
            <user:FormButtonsBox
                Grid.Row="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="58,0,10,10"
                IsOkEnabled="{Binding IsOkEnabled}"
                CancelCommand="{Binding CancelCommand}" 
                OkCommand="{Binding OkCommand}"
                Grid.ColumnSpan="2">
            </user:FormButtonsBox>
        </Grid>
    </Border>
</local:EditorWindow>
