<local:EditorWindow x:Class="Oil_level_glass_UI.Windows.Editors.HousingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:user="clr-namespace:KompasWPF.UserControls;assembly=KompasWPF"
        xmlns:local="clr-namespace:Oil_level_glass_UI.Windows.Editors"
        xmlns:converter="clr-namespace:Oil_level_glass_UI.Converters"
        mc:Ignorable="d"
        Title="Размеры корпуса"
        Height="600" 
        Width="550"
        ResizeMode="NoResize" 
        ShowInTaskbar="False">
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid Background="#F2F2F2">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource FormButton}">

                </Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="5"></Setter>
                </Style>
                <converter:DoubleConverter x:Key="doubleConverter"></converter:DoubleConverter>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Border  Grid.Row="0" BorderBrush="Black" BorderThickness="0 0 0 2" Grid.ColumnSpan="2">
                <StackPanel Margin="0">
                    <StackPanel Height="20" Margin="0" Background="#E4E4E4" Name="WindowHeader"></StackPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="10" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"  Name="grSizes">
                    <Grid.Resources>
                        <Style TargetType="Label">
                            <Setter Property="Padding" Value="0"></Setter>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Margin" Value="0 0 20 0"></Setter>
                            <Setter Property="Width" Value="200"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Диаметры" Margin="10" Grid.Row="0">
                        <Grid>
                            
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <Label Content="Диаметр D"></Label>
                                <TextBox></TextBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <Label Content="Диаметр D1"></Label>
                                <TextBox></TextBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <Label Content="Диаметр D2"></Label>
                                <TextBox></TextBox>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Высоты" Margin="10" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Label Content="Высота h"></Label>
                                <TextBox></TextBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <Label Content="Высота h2"></Label>
                                <TextBox></TextBox>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Фаска" Margin="10" Grid.Row="2">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="StackPanel">
                                    <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Label Content="Угол a"></Label>
                                <TextBox></TextBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0 5">
                                <Label Content="Длина l"></Label>
                                <TextBox></TextBox>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="4">
                        <Grid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource FormButton}">
                                <Setter Property="Width" Value="110"></Setter>
                                <Setter Property="Height" Value="20"></Setter>
                                <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
                                <Setter Property="Margin" Value="10"></Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button 
                            Grid.Column="0" 
                             Click="BtCheck_Click"
                             Command="{Binding CheckCommand}"

                             Content="Проверить...">
                        </Button>

                        <Button 
                            Grid.Column="1"
                            Content="Мастер отверстия...">
                            
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Column="1" Grid.Row="1" BorderBrush="Black" BorderThickness="1" Margin="0 20 10 20">
                <Image Source="/Resources/Images/Housing.bmp" Stretch="Fill">
                    
                </Image>
            </Border>
            <user:FormButtonsBox
                Grid.Row="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="58,0,10,10"
                IsOkEnabled="{Binding IsOkEnabled}"
                CancelCommand="{Binding CancelCommand}" 
                OkCommand="{Binding OkCommand}"
                Grid.ColumnSpan="2">
            </user:FormButtonsBox>
        </Grid>
    </Border>
</local:EditorWindow>
