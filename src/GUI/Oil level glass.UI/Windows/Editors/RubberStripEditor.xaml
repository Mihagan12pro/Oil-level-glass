<local:EditorWindow x:Class="Oil_level_glass_UI.Windows.Editors.RubberStripEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Oil_level_glass_UI.Windows.Editors"
    xmlns:user="clr-namespace:KompasWPF.UserControls;assembly=KompasWPF"
    xmlns:converter="clr-namespace:Oil_level_glass_UI.Converters"
    mc:Ignorable="d"
    Title="Размеры линзы"
    Height="250" 
    Width="280"
    ResizeMode="NoResize" 
    ShowInTaskbar="False">
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid Background="#F2F2F2">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource FormButton}">

                </Style>
                <converter:DoubleConverter x:Key="doubleConverter"></converter:DoubleConverter>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="183*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Border  Grid.Row="0" BorderBrush="Black" BorderThickness="0 0 0 2" Grid.ColumnSpan="2">
                <StackPanel>
                    <StackPanel Height="20" Background="#E4E4E4" Name="WindowHeader"></StackPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="10,10,10,10" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"  Name="grSizes">
                    <Grid.Resources>
                        <Style TargetType="Label">
                            <Setter Property="Padding" Value="0"></Setter>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Margin" Value="0 0 20 0"></Setter>
                            <Setter Property="Width" Value="100"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <Label Content="Диаметр D">

                        </Label>
                        <TextBox Name="tbExternalDiameter" Text="{Binding ExternalDiameter}" IsEnabled="False">
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Label Content="Толщина h">

                        </Label>
                        <TextBox Name="tbHeight" Text="{Binding Height}" IsEnabled="false">
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <Label Content="Диаметр D2">

                        </Label>
                        <TextBox Name="tbInternalDiameter">
                            <TextBox.Text>
                                <Binding Path="InternalDiameter" UpdateSourceTrigger="Explicit" Converter="{StaticResource doubleConverter}" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <DataErrorValidationRule></DataErrorValidationRule>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>
                    <Button 
                        Grid.Row="3"
                        Width="100" 
                        Click="BtCheck_Click"
                        Command="{Binding CheckCommand}"
                        Height="20" 
                        HorizontalAlignment="Left"
                        Content="Проверить...">
                    </Button>
                </Grid>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1">
                    <Image Source="/Resources/Images/RubberStrip.bmp">

                    </Image>
                </Border>
            </Grid>
            <user:FormButtonsBox
                Grid.Row="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="58,0,10,10"
                IsOkEnabled="{Binding IsOkEnabled}"
                CancelCommand="{Binding CancelCommand}" 
                OkCommand="{Binding OkCommand}"
                Grid.ColumnSpan="2">
            </user:FormButtonsBox>
        </Grid>
    </Border>
</local:EditorWindow>