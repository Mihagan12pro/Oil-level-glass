<kompas:KompasWindow x:Class="Oil_level_glass_UI.Windows.Wizard3D.Wizard3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Oil_level_glass_UI.Windows.Wizard3D"
        xmlns:kompas="clr-namespace:KompasWPF;assembly=KompasWPF"
        xmlns:converter="clr-namespace:Oil_level_glass_UI.Converters"
        xmlns:user="clr-namespace:KompasWPF.UserControls;assembly=KompasWPF"
        mc:Ignorable="d"
        Title="МАСТЕР ТРЕХМЕРНОЙ МОДЕЛИ" 
        Height="600"
        Width="600" 
        Style="{DynamicResource KompasWindowStyle}" ResizeMode="CanMinimize">
    <Window.Resources>

    </Window.Resources>

    <Grid>
        <Grid.Resources>
            <Style TargetType="StackPanel">
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Padding" Value="0"></Setter>
                <Setter Property="Width" Value="60"></Setter>
                <Setter Property="Height" Value="20"></Setter>
                <Setter Property="FontSize" Value="10"></Setter>
                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
            </Style>
            <Style TargetType="user:MaterialChooser">
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0 20"></Setter>
            </Style>

            <Style TargetType="user:AppearanceEditor">
                <Setter Property="Header" Value="Вид"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0"></Setter>
            </Style>

            <Style TargetType="user:SavingEditor">
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0 0 0 20"></Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <GroupBox
            Header="Выбор материалов"
            Margin="20"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <user:MaterialChooser
                    Grid.Row="0" 
                    Header="Линза"
                    Title="{Binding Glass.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding Glass.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectGlassMaterialCommand}">
                    
                </user:MaterialChooser>
                
                <user:MaterialChooser 
                    Grid.Row="1" 
                    Header="Резиновая прокладка"
                    Title="{Binding RubberStrip.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding RubberStrip.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectStripMaterialCommand}">

                </user:MaterialChooser>
                
                <user:MaterialChooser 
                    Grid.Row="2" 
                    Header="Корпус"
                    Title="{Binding Housing.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding Housing.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectHousingMaterialCommand}">

                </user:MaterialChooser>
            </Grid>
        </GroupBox>

        <GroupBox 
            Visibility="{Binding PageTwoVisibility}"
            Header="Назначение размеров"
            Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                        <Image>
                            
                        </Image>
                    </Border>
                    <GroupBox Grid.Column="1" Margin="20 0 0 0" Header="Просмотр чертежей">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="RadioButton">
                                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                    <Setter Property="Margin" Value="10 0 0 0"></Setter>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <RadioButton Grid.Row="0" Content="Смотровой лючок в сборке">
                                
                            </RadioButton>
                            <RadioButton Grid.Row="1" Content="Корпус смотрового лючка">

                            </RadioButton>
                            <RadioButton Grid.Row="2" Content="Линза смотрового лючка">

                            </RadioButton>
                            <RadioButton Grid.Row="3" Content="Резиновая прокладка под линзу">

                            </RadioButton>
                        </Grid>
                    </GroupBox>
                </Grid>

                <GroupBox Grid.Row="1" Header="Назначенные размеры" Margin="20 0 10 20">
                    <WrapPanel>
                        
                    </WrapPanel>
                </GroupBox>
                
                <Grid Grid.Row="2" Margin="0 0 0 10">
                    <Grid.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Orientation" Value="Horizontal"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                        </Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FormButton}">
                            <Setter Property="Content" Value="Назначить..."></Setter>
                            <Setter Property="Height" Value="16"></Setter>
                            <Setter Property="FontSize" Value="10"></Setter>
                        </Style>
                        <Style TargetType="Label">
                            <Setter Property="FontSize" Value="10"></Setter>
                            <Setter Property="Padding" Value="0"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="Margin" Value="0 0 10 0"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Размеры линзы "></Label>
                        <Button></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="Размеры прокладки "></Label>
                        <Button></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Размеры корпуса "></Label>
                        <Button></Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <Border 
            BorderBrush="Black" 
            BorderThickness="0 1 0 0"
            Grid.Row="1"
            Padding="0"
            Height="60">
            <StackPanel 
                Margin="20 0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                
                <Button
                    Margin="20 0"
                    Content="Назад"
                    IsEnabled="{Binding IsBackEnabled}"
                    Command="{Binding BackCommand}">
                </Button>

                <Button
                    Content="Далее"
                    IsEnabled="{Binding IsNextEnabled}"
                    Command="{Binding NextCommand}">
                </Button>

            </StackPanel>
        </Border>
        
    </Grid>
    
</kompas:KompasWindow>
