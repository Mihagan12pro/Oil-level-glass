<kompas:KompasWindow x:Class="Oil_level_glass_UI.Windows.Wizard3D.Wizard3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Oil_level_glass_UI.Windows.Wizard3D"
        xmlns:kompas="clr-namespace:KompasWPF;assembly=KompasWPF"
        xmlns:converter="clr-namespace:Oil_level_glass_UI.Converters"
        xmlns:user="clr-namespace:KompasWPF.UserControls;assembly=KompasWPF"
        mc:Ignorable="d"
        Title="МАСТЕР ТРЕХМЕРНОЙ МОДЕЛИ" 
        Height="500"
        Width="650" 
        Style="{DynamicResource KompasWindowStyle}" ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="user:MaterialChooser">
            <Setter Property="Width" Value="376"></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource FormButton}" x:Key="wizardButton">
            <Setter Property="Height" Value="18"></Setter>
            <Setter Property="MaxHeight" Value="18"></Setter>
            <Setter Property="FontSize" Value="10"></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Resources>
            <Style TargetType="StackPanel">
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Padding" Value="0"></Setter>
                <Setter Property="Width" Value="60"></Setter>
                <Setter Property="Height" Value="20"></Setter>
                <Setter Property="FontSize" Value="10"></Setter>
                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
            </Style>
            <Style TargetType="user:MaterialChooser">
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0 20"></Setter>
            </Style>

            <Style TargetType="user:AppearanceEditor">
                <Setter Property="Header" Value="Вид"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0"></Setter>
            </Style>

            <Style TargetType="user:SavingEditor">
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0 0 0 20"></Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <GroupBox
            Header="Выбор материалов"
            Margin="20"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <user:MaterialChooser
                    Grid.Row="0" 
                    Header="Линза"
                    Width="550"
                    Title="{Binding Glass.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding Glass.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectGlassMaterialCommand}">
                    
                </user:MaterialChooser>
                
                <user:MaterialChooser 
                    Grid.Row="1" 
                    Header="Резиновая прокладка"
                    Width="550"
                    Title="{Binding RubberStrip.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding RubberStrip.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectStripMaterialCommand}">

                </user:MaterialChooser>
                
                <user:MaterialChooser 
                    Grid.Row="2" 
                    Header="Корпус"
                    Title="{Binding Housing.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding Housing.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectHousingMaterialCommand}" Width="550">

                </user:MaterialChooser>
            </Grid>
        </GroupBox>

        <GroupBox 
            Visibility="Visible"
            Header="Назначение размеров"
            Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <GroupBox Header="Чертежи" Margin="20 10 20 0">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                                <Setter Property="Margin" Value="0 0 0 10"></Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Margin="10">
                            <Image>
                                
                            </Image>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="Корпус"></RadioButton>
                            <RadioButton Grid.Column="1" Content="Линза"></RadioButton>
                            <RadioButton Grid.Column="2" Content="Прокладка"></RadioButton>
                            <RadioButton Grid.Column="3" Content="Сборка"></RadioButton>
                        </Grid>
                    </Grid>
                </GroupBox>

                <Grid Grid.Row="1" Margin="20 0">
                    <Grid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource wizardButton}">
                            <Setter Property="Width" Value="65"></Setter>
                            <Setter Property="Margin" Value="0 10"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Button Content="Линза..." Grid.Column="0" HorizontalAlignment="Left">
                        
                    </Button>
                    <Button Content="Прокладка..." Grid.Column="1" HorizontalAlignment="Center">

                    </Button>
                    <Button Content="Корпус..." Grid.Column="2" HorizontalAlignment="Right" Click="Button_Click">

                    </Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0 0 0 5">
                    <Grid.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Orientation" Value="Horizontal"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                        </Style>
                        <Style TargetType="Label">
                            <Setter Property="FontSize" Value="10"></Setter>
                            <Setter Property="Padding" Value="0"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="Margin" Value="0 0 10 0"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Grid>
        </GroupBox>

        <Border 
            BorderBrush="Black" 
            BorderThickness="0 1 0 0"
            Grid.Row="1"
            Padding="0"
            Height="60">
            <StackPanel 
                Margin="20 0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                
                <Button
                    Margin="20 0"
                    Content="Назад"
                    IsEnabled="{Binding IsBackEnabled}"
                    Command="{Binding BackCommand}">
                </Button>

                <Button
                    Content="Далее"
                    IsEnabled="{Binding IsNextEnabled}"
                    Command="{Binding NextCommand}">
                </Button>

            </StackPanel>
        </Border>
        
    </Grid>
    
</kompas:KompasWindow>
