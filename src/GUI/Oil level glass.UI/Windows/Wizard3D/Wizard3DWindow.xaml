<kompas:KompasWindow x:Class="Oil_level_glass_UI.Windows.Wizard3D.Wizard3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Oil_level_glass_UI.Windows.Wizard3D"
        xmlns:kompas="clr-namespace:KompasWPF;assembly=KompasWPF"
        xmlns:converter="clr-namespace:Oil_level_glass_UI.Converters"
        xmlns:user="clr-namespace:KompasWPF.UserControls;assembly=KompasWPF"
        mc:Ignorable="d"
        Title="МАСТЕР ТРЕХМЕРНОЙ МОДЕЛИ" 
        Height="600"
        Width="600" 
        Style="{DynamicResource KompasWindowStyle}" ResizeMode="CanMinimize">
    <Window.Resources>

    </Window.Resources>

    <Grid>
        <Grid.Resources>
            <Style TargetType="StackPanel">
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Padding" Value="0"></Setter>
                <Setter Property="Width" Value="60"></Setter>
                <Setter Property="Height" Value="20"></Setter>
                <Setter Property="FontSize" Value="10"></Setter>
                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
            </Style>
            <Style TargetType="user:MaterialChooser">
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0 20"></Setter>
            </Style>

            <Style TargetType="user:AppearanceEditor">
                <Setter Property="Header" Value="Вид"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0"></Setter>
            </Style>

            <Style TargetType="user:SavingEditor">
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Width" Value="500"></Setter>
                <Setter Property="Margin" Value="0 0 0 20"></Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <GroupBox
            Header="Выбор материалов"
            Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <user:MaterialChooser
                    Grid.Row="0" 
                    Header="Линза"
                    Title="{Binding Glass.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding Glass.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectGlassMaterialCommand}">
                    
                </user:MaterialChooser>
                
                <user:MaterialChooser 
                    Grid.Row="1" 
                    Header="Резиновая прокладка"
                    Title="{Binding RubberStrip.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding RubberStrip.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectStripMaterialCommand}">

                </user:MaterialChooser>
                
                <user:MaterialChooser 
                    Grid.Row="2" 
                    Header="Корпус"
                    Title="{Binding Housing.Material.Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Density="{Binding Housing.Material.Density, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Command="{Binding SelectHousingMaterialCommand}">

                </user:MaterialChooser>
            </Grid>
        </GroupBox>

        <Border 
            BorderBrush="Black" 
            BorderThickness="0 1 0 0"
            Grid.Row="1"
            Padding="0"
            Height="60">
            <StackPanel 
                Margin="20 0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                
                <Button
                    Margin="20 0"
                    Content="Назад"
                    IsEnabled="{Binding IsBackEnabled}">
                </Button>

                <Button
                    Content="Далее"
                    IsEnabled="{Binding IsNextEnabled}">
                </Button>

            </StackPanel>
        </Border>
        
    </Grid>
    
</kompas:KompasWindow>
