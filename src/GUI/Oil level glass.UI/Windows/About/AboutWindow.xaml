<kompas:KompasWindow x:Class="Oil_level_glass_UI.Windows.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Oil_level_glass_UI.Windows.About"
        xmlns:kompas="clr-namespace:KompasWPF;assembly=KompasWPF"
        xmlns:kompasControl="clr-namespace:KompasWPF.UserControls;assembly=KompasWPF"
        mc:Ignorable="d"
        Title="О ПРОГРАММЕ" Height="510" Width="510" Style="{DynamicResource KompasWindowStyle}" ResizeMode="NoResize">
    <Grid Margin="0 10 0 0">
        <StackPanel>
            <Border BorderThickness="0 0 0 1" BorderBrush="Black" Margin="0 0 0 5">
                <kompasControl:XpsViewer Document="{Binding DocumentSource}">
                    
                </kompasControl:XpsViewer>
            </Border>
            <Button 
                Name="btClose"
                Style="{StaticResource FormButton}" 
                Height="20"
                Width="80" 
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10 8"
                Content="Закрыть" Click="btClose_Click">
            </Button>
        </StackPanel>
    </Grid>
</kompas:KompasWindow>
