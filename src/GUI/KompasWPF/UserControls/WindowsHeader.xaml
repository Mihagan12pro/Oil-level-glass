<UserControl x:Class="KompasWPF.UserControls.WindowsHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d">
    <Border BorderBrush="Black" BorderThickness="0 0 0 2">
        <StackPanel HorizontalAlignment="Stretch" Height="20" Background="#E4E4E4">
            <Button Name="btClose" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent">
                <icons:PackIconMaterial Kind="WindowClose"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
