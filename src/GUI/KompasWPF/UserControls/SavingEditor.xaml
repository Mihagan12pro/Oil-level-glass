<local:GroupControlBase x:Class="KompasWPF.UserControls.SavingEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="440" MinHeight="100" x:Name="editor">
    <Grid>
        <GroupBox Name="gbPartSaving" Foreground="Black" Header="{Binding ElementName=editor, Path=Header}" MinWidth="440"   HorizontalAlignment="Stretch" >
            <Grid Margin="10 0 0 2">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="0.25*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Height="18">
                        <TextBlock>
                            
                        </TextBlock>
                    </Border>
                    <Button 
                        Grid.Column="1"
                        FontSize="10"
                        Margin="10 0 10 0" 
                        Width="60"
                        MaxHeight="18"
                        MinHeight="18" 
                        Style="{StaticResource FormButton}"
                        Content="Выбрать...">
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="0.25*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Height="18" FontSize="10">

                    </TextBox>
                    <Label 
                        Padding="0"
                        Content="Обозначение"
                        Height="18"
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        FontSize="10"
                        Grid.Column="1"
                        Margin="10 0 10 0" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="0.25*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Height="18" FontSize="10">

                    </TextBox>
                    <Label 
                        Content="Наименование"
                        Padding="0"
                        Height="18"
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        FontSize="10"
                        Grid.Column="1" />
                </Grid>

            </Grid>
        </GroupBox>
    </Grid>
</local:GroupControlBase>
