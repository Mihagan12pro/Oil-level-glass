<local:GroupControlBase x:Class="KompasWPF.UserControls.SavingEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d" 
             MinHeight="100" x:Name="editor" HorizontalAlignment="Stretch">
    <Grid>
        <GroupBox 
            Name="gbPartSaving" 
            Foreground="Black" 
            Header="{Binding ElementName=editor, Path=Header}" 
            HorizontalAlignment="Stretch">
            
            <Grid Margin="10 0 0 2">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Border 
                    Grid.Column="0"  
                    Grid.Row="0" 
                    BorderBrush="Black" 
                    BorderThickness="1"
                    Height="18">
                    <TextBlock Text="{Binding ElementName=editor, Path=Directory}">

                    </TextBlock>
                </Border>
                <Button 
                    Grid.Column="1"
                    Grid.Row="0"
                    FontSize="10"
                    Margin="10 0 10 0" 
                    Width="60"
                    MaxHeight="18"
                    MinHeight="18" 
                    Style="{StaticResource FormButton}"
                    Content="Выбрать..."
                    Command="{Binding ElementName=editor, Path=Command}">
                </Button>

                <TextBox 
                    Grid.Column="0" 
                     Grid.Row="1"
                    Height="18"
                    FontSize="10" 
                    Text="{Binding ElementName=editor, Path=Marking}">

                </TextBox>
                <Label 
                    Padding="0"
                    Content="Обозначение"
                    Height="18"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10 0 10 0">
                </Label>

                <TextBox 
                    Grid.Row="2"
                    Grid.Column="0" 
                    Height="18" 
                    FontSize="10"
                    Text="{Binding ElementName=editor, Path=Naming}">
                </TextBox>
                <Label 
                    Content="Наименование"
                    Padding="0"
                    Height="18"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Grid.Row="2"
                    Grid.Column="1">
                </Label>

            </Grid>
            
        </GroupBox>
    </Grid>
</local:GroupControlBase>
