<local:GroupControlBase x:Class="KompasWPF.UserControls.AppearanceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:user="clr-namespace:KompasWPF.UserControls"
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d" 
             x:Name="editor" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid>
        <GroupBox 
            Header="{Binding ElementName=editor, Path=Header}" 
            Foreground="Black" 
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <GroupBox.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource FormButton}">
                    <Setter Property="FontSize" Value="10"></Setter>
                </Style>
                <Style TargetType="local:SelectingValueSlider">
                    <Setter Property="Width" Value="Auto"></Setter>
                    <Setter Property="Margin" Value="0 5"></Setter>
                </Style>
            </GroupBox.Resources>
            <Grid VerticalAlignment="Stretch" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Rectangle 
                    Name="rectColor"
                    Stroke="Gray"
                    Height="20"
                    StrokeThickness="1"
                    Grid.Column="0"
                    Grid.Row="0">
                </Rectangle>
                <Button 
                    Height="20"
                    Width="60"
                    Margin="10 0 0 0"
                    Grid.Column="1"
                    Command="{Binding ElementName=editor, Path=Command}"
                    Content="Выбрать...">
                </Button>

                <local:SelectingValueSlider 
                    Header="Прозрачность" 
                    Value="{Binding ElementName=editor, Path=Transparency}"
                    Grid.Row="1"
                    Grid.Column="0">
                </local:SelectingValueSlider>
                
                <local:SelectingValueSlider 
                    Header="Общий цвет" 
                    Value="{Binding ElementName=editor, Path=Ambient, Mode=TwoWay}"
                    Grid.Row="2"
                    Grid.Column="0">
                </local:SelectingValueSlider>
                
                <local:SelectingValueSlider 
                    Header="Диффузия"
                    Value="{Binding ElementName=editor, Path=Diffuse}"
                    Grid.Row="3"
                    Grid.Column="0">
                </local:SelectingValueSlider>
                
                <local:SelectingValueSlider 
                    Header="Зеркальность" 
                    Value="{Binding ElementName=editor, Path=Specularity}"
                    Grid.Row="4"
                    Grid.Column="0">
                </local:SelectingValueSlider>
                
                <local:SelectingValueSlider 
                    Header="Блеск" 
                    Value="{Binding ElementName=editor, Path=Shininess}"
                    Grid.Row="5"
                    Grid.Column="0">
                </local:SelectingValueSlider>
                
                <local:SelectingValueSlider 
                    Header="Излучение"
                    Value="{Binding ElementName=editor, Path=Emission}"
                    Grid.Row="6"
                    Grid.Column="0">
                </local:SelectingValueSlider>
            </Grid>
        </GroupBox>
    </Grid>
</local:GroupControlBase>
