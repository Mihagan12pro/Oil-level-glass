<local:GroupControlBase x:Class="KompasWPF.UserControls.AppearanceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400" x:Name="editor">
    <Grid>
        <GroupBox Header="{Binding ElementName=editor, Path=Header}">
            <Slider Style="{DynamicResource SelectValueSliderStyle}" HorizontalAlignment="Left" Margin="171,0,0,0" Width="120" Height="21"/>

        </GroupBox>
    </Grid>
</local:GroupControlBase>
