<local:GroupControlBase x:Class="KompasWPF.UserControls.ThreadChooser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="350" MinHeight="140" x:Name="chooser">
    <Grid>
        <GroupBox 
            Header="{Binding ElementName=chooser, Path=Header}" 
            MinHeight="140"
            HorizontalAlignment="Stretch"
            Foreground="Black"
            Width="350">
            <Grid Margin="10 10 10 0" VerticalAlignment="Stretch" Width="320">
                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="Padding" Value="0"></Setter>
                        <Setter Property="FontSize" Value="10"></Setter>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Padding" Value="0"></Setter>
                        <Setter Property="FontSize" Value="10"></Setter>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Padding" Value="0"></Setter>
                        <Setter Property="FontSize" Value="10"></Setter>
                    </Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Black"></Setter>
                        <Setter Property="BorderThickness" Value="1"></Setter>
                    </Style>
                    <Style TargetType="Grid">
                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                    </Style>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Column="0" 
                        Content="Стандарт">
                    </Label>
                    <Border
                        Grid.Column="1" 
                        BorderBrush="Black" 
                        BorderThickness="1"
                        VerticalAlignment="Center" Margin="5 0">
                        <TextBlock Text="{Binding ElementName=chooser, Path=Standard}">

                        </TextBlock>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*">

                        </ColumnDefinition>
                        <ColumnDefinition>

                        </ColumnDefinition>
                        <ColumnDefinition>

                        </ColumnDefinition>
                        <ColumnDefinition>

                        </ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Label 
                        Grid.Column="0"
                        Padding="0" 
                        VerticalAlignment="Center"
                        Content="Номинальный диаметр">
                    </Label>
                    <Border Grid.Column="1">
                        <TextBlock Text="{Binding ElementName=chooser, Path=NominalDiameter}">
                            
                        </TextBlock>
                    </Border>


                    <Label 
                        Grid.Column="2" 
                        Content="Шаг резьбы"
                        HorizontalAlignment="Right">
                    </Label>
                    <Border Grid.Column="3" Margin="5 0">
                        <TextBlock Text="{Binding ElementName=chooser, Path=Pitch}">
                            
                        </TextBlock>
                    </Border>
                </Grid>


                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="0.6*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Label 
                        Grid.Column="0" 
                        Content="Максимальный номинальный диаметр:">
                    </Label>
                    <Label
                        Grid.Column="1"
                        Content="{Binding ElementName=chooser, Path=MaxNominalDiameter}">
                    </Label>
                </Grid>
                <Button 
                    Grid.Row="3"
                    Width="60"
                    Height="18"
                    FontSize="10"
                    MaxHeight="18"
                    Command="{Binding ElementName=chooser, Path=Command}"
                    HorizontalAlignment="Left"
                    Content="Выбрать..."
                    Style="{StaticResource FormButton}">
                </Button>
            </Grid>
        </GroupBox>
    </Grid>
</local:GroupControlBase>