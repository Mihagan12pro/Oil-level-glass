<local:GroupControlBase x:Class="KompasWPF.UserControls.ThreadChooser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="350" MaxWidth="350" MinHeight="140" x:Name="chooser">
    <Grid>
        <GroupBox 
            Header="{Binding ElementName=chooser, Path=Header}" 
            MinHeight="140"
            HorizontalAlignment="Stretch"
            Foreground="Black"
            Width="350">
            <StackPanel Margin="10 10 10 0" VerticalAlignment="Stretch" Width="320">
                <StackPanel.Resources>
                    <Style TargetType="Label">
                        <Setter Property="Padding" Value="0"></Setter>
                        <Setter Property="FontSize" Value="10"></Setter>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Padding" Value="0"></Setter>
                        <Setter Property="FontSize" Value="10"></Setter>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Padding" Value="0"></Setter>
                        <Setter Property="FontSize" Value="10"></Setter>
                    </Style>
                </StackPanel.Resources>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Стандарт"></Label>

                    <Border 
                        Margin="10 0 0 0" 
                        BorderBrush="Black" 
                        BorderThickness="1" 
                        Width="250">
                        <TextBlock Text="{Binding ElementName=chooser, Path=Standard}"></TextBlock>
                    </Border>
                </StackPanel>
                <DockPanel Margin="0 10 0 0">
                    <DockPanel.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Orientation" Value="Horizontal"></Setter>
                        </Style>
                    </DockPanel.Resources>
                    
                    <StackPanel DockPanel.Dock="Left">
                        <Label Content="Номинальный диаметр"></Label>
                        <Border 
                             Margin="10 0 0 0" 
                             BorderBrush="Black" 
                             BorderThickness="1" 
                             Width="60">
                            <TextBlock Text="{Binding ElementName=chooser, Path=NominalDiameter}"></TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Margin="20 0 8 0" HorizontalAlignment="Right">
                        <Label Content="Шаг">
                            
                        </Label>
                        <Border 
                          Margin="10 0 10 0" 
                          BorderBrush="Black" 
                          BorderThickness="1" 
                          Width="55">
                           <TextBlock Text="{Binding ElementName=chooser, Path=Pitch}"></TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <StackPanel>
                    <Expander Header="Ограничения" FontSize="10">
                        <StackPanel Orientation="Horizontal" Margin="25 0">
                            <Label Content="Максимальный номинальный диаметр"></Label>
                            <Label Margin="10 0" Content="{Binding ElementName=chooser, Path=MaxNominalDiameter}"></Label>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Button 
                        HorizontalAlignment="Left" 
                        FontSize="10" 
                        Style="{StaticResource FormButton}" 
                        Content="Выбрать..." 
                        Width="60"
                        MaxHeight="18"
                        Height="18"
                        Margin="0 10"
                        Command="{Binding ElementName=chooser, Path=Command}">
                </Button>
            </StackPanel>
        </GroupBox>
    </Grid>
</local:GroupControlBase>
