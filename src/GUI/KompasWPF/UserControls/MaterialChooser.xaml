<UserControl x:Class="KompasWPF.UserControls.MaterialChooser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="400" MinHeight="70" x:Name="chooser" >
    <Grid>
        <GroupBox Name="gbPartMaterial" Header="{Binding ElementName=chooser, Path=Title}" Foreground="Black" HorizontalAlignment="Center">
            <StackPanel Margin="10 5 0 0" MinHeight="14" VerticalAlignment="Center">
                <Image Visibility="Collapsed" Name="imgPartSketch" Margin="5" Stretch="Fill">

                </Image>
                <StackPanel Orientation="Horizontal" Height="20">
                    <Border Width="315" Margin="0 0 10 0" BorderThickness="1" BorderBrush="Black">
                        <StackPanel>
                            <TextBlock Name="tbkMaterialTitle"/>
                        </StackPanel>
                    </Border>
                    <Button Name="btSelect"  HorizontalAlignment="Center" FontSize="12" Style="{StaticResource FormButton}" Content="Выбрать..." Width="60"></Button>
                </StackPanel>
                <Expander Header="Остальные параметры" Margin="0 10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Штриховка: "></Label>
                            <TextBlock></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Плотность: "></Label>
                            <TextBlock Width="50"></TextBlock>
                            <Label Content="г/см³"></Label>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
