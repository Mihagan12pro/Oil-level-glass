<UserControl x:Class="KompasWPF.UserControls.MaterialChooser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KompasWPF.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="35" d:DesignWidth="400" MinHeight="35">
    <Grid>
        <GroupBox Name="gbPartMaterial">
            <StackPanel Margin="10 10 0 0" MinHeight="14" VerticalAlignment="Top">
                <Image Visibility="Collapsed" Name="imgPartSketch" Margin="5">
                    
                </Image>
                <StackPanel Orientation="Horizontal" Height="14">
                    <TextBlock Name="tbkMaterialTitle" Background="White" Width="315" Margin="0 0 10 0"/>
                    <Button Name="btSelect" FontSize="9" Style="{StaticResource FormButton}" Content="Выбрать..." Width="43"></Button>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
